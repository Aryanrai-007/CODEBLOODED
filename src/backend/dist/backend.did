type Timestamp = int;
type SubmitResult = 
 variant {
   err: text;
   ok: nat;
 };
type CreateResult = 
 variant {
   err: text;
   ok: text;
 };
type CreateEventInput = 
 record {
   category: text;
   date: text;
   description: text;
   subject: text;
   time: text;
 };
type ChessScoreResult = 
 variant {
   err: text;
   ok;
 };
type ChessScore = 
 record {
   botName: text;
   createdAt: Timestamp;
   movesCount: nat;
   playerId: text;
   result: text;
   score: nat;
 };
type ChessPlayer = 
 record {
   createdAt: Timestamp;
   playerId: text;
   username: text;
 };
type CalendarEvent = 
 record {
   category: text;
   createdAt: Timestamp;
   date: text;
   description: text;
   id: nat;
   subject: text;
   time: text;
 };
type ApplicationStatus = 
 variant {
   approved;
   pending;
 };
type Application = 
 record {
   department: text;
   email: text;
   id: nat;
   name: text;
   phone: text;
   priorExperience: text;
   reasonForJoining: text;
   status: ApplicationStatus;
   submittedAt: Timestamp;
   yearOfStudy: text;
 };
service : {
  approveApplication: (id: nat) -> (bool);
  createChessPlayer: (username: text) -> (CreateResult);
  createEvent: (input: CreateEventInput) -> (nat);
  deleteApplication: (id: nat) -> (bool);
  deleteChessPlayer: (playerId: text) -> (bool);
  deleteEvent: (id: nat) -> (bool);
  getApplications: () -> (vec Application) query;
  getChessLeaderboard: () -> (vec ChessScore) query;
  getChessPlayers: () -> (vec ChessPlayer) query;
  getChessScores: () -> (vec ChessScore) query;
  getEvents: () -> (vec CalendarEvent) query;
  submitApplication: (name: text, email: text, phone: text, yearOfStudy:
   text, department: text, reasonForJoining: text, priorExperience: text) ->
   (SubmitResult);
  submitChessScore: (playerId: text, botName: text, score: nat, result: 
   text, movesCount: nat) -> (ChessScoreResult);
  updateEvent: (id: nat, input: CreateEventInput) -> (bool);
}
