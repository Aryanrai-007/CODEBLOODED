rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isLord() {
      return signedIn() && request.auth.token.email in [
        'aryanraiavengers@gmail.com',
        'harsh@codeblooded.com',
        'ishant@codeblooded.com',
        'suraj@codeblooded.com',
        'mridul@codeblooded.com'
      ];
    }

    function validUser(data) {
      return data.keys().hasAll([
        'email', 'name', 'role', 'houseId',
        'gender', 'characterClass', 'createdAt', 'updatedAt'
      ])
      && data.email is string
      && data.name is string
      && data.role in ['admin', 'member']
      && data.houseId is string
      && data.gender in ['male', 'female', 'none']
      && data.characterClass in ['warrior', 'archer', 'knight', 'mage', 'none'];
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isLord());
      allow list: if isLord();

      allow create: if signedIn()
        && request.auth.uid == userId
        && validUser(request.resource.data)
        && request.resource.data.email == request.auth.token.email
        && (
          request.resource.data.role == 'member'
          || (
            request.resource.data.role == 'admin'
            && isLord()
          )
        );

      allow update: if signedIn()
        && request.auth.uid == userId
        && validUser(request.resource.data)
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.name == resource.data.name
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['houseId', 'gender', 'characterClass', 'updatedAt']);

      allow delete: if false;
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow create, update, delete: if isLord()
        && request.resource.data.houseId is string;
    }

    match /houses/{houseId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
